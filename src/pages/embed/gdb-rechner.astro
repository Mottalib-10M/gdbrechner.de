---
/** Einbettbare Seite (iframe): Gesamt-GdB-Rechner ohne Navigation. noindex, nicht in der Sitemap (astro.config). */
import '../../styles/global.css';
import GesamtRechner from '../../components/calc/GesamtRechner';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
const de = route('home', 'de');
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gesamt-GdB-Rechner 2026</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}${de}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <GesamtRechner client:load methodHref={`${SITE_URL}${route('method', 'de')}`} />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}${de}`} target="_blank" rel="noopener" class="underline">Gesamt-GdB nach VersMedV · {SITE_NAMES.de}</a></p>
  </body>
</html>
