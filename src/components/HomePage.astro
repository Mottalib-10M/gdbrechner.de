---
/**
 * Startseite (Säule, RECETTE §5): Rechtsstand mit Datum, sofort der Gesamt-GdB-Rechner (ohne Scrollen sichtbar),
 * der zitierbare Absatz (eingeklappt), die vier Zusammenhänge als Spannen, eine Randspalte mit verbreiteten
 * Irrtümern, dann der Text mit Mini-Rechner und die FAQ.
 */
import PageLayout from '../layouts/PageLayout.astro';
import GesamtRechner from './calc/GesamtRechner';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import { HOME } from '../content/home';
import { route, ROUTES, type Locale } from '../i18n/routes';
import { label } from '../i18n/nav';
import { helpers } from '../lib/helpers';
import { P, type SourceKey } from '../lib/engine/params';
import { gesamtGdb } from '../lib/engine/gesamt';
import { formatMoney, displayDate } from '../lib/format';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { LANG_TAGS } from '../data/site-config';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME.de;
const h = helpers(lang);
const path = route('home', lang);
const parts = x.body(h).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const faqs = x.faqs(h);
const keys: SourceKey[] = ['versmedv', 'bgbl2025', 'versmedvAlt', 'sgb9_2', 'sgb9_152', 'estg33b', 'estg33', 'sgb9_208', 'sgb9_173', 'sgb6_37'];
const sources = keys.map((k) => ({ name: P.sources[k].label.de, url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(faqs, lang)];
const dt = (iso: string) => displayDate(iso, LANG_TAGS[lang]);
const r = (id: string) => (ROUTES.some((y) => y.id === id) ? route(id, lang) : undefined);
// Zweites Leiden mit GdB 10 bis 50 neben einem ersten von 40: Spanne je Zusammenhang.
const zweite = [10, 20, 30, 40, 50];
const arten = [
  { b: 'nachteilig', name: 'verstärken sich' },
  { b: 'unabhaengig', name: 'andere Lebensbereiche' },
  { b: 'teilweise', name: 'teilweise dieselben' },
  { b: 'vollstaendig', name: 'dieselben Folgen' },
] as const;
const raster = zweite.map((g) => ({ g, w: arten.map((a) => gesamtGdb([{ system: 'a', gdb: 40 }, { system: 'b', gdb: g, beziehung: a.b }])) }));
const sp = (q: { min: number; max: number }) => (q.min === q.max ? `${q.min}` : `${q.min}–${q.max}`);
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} sources={sources}>
  <header class="mb-4">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-800">Versorgungsmedizin-Verordnung, Teil A neu gefasst seit {dt(P.versmedv.in_kraft)}</p>
    <h1 class="mt-1 text-3xl font-bold text-navy-900 md:text-[2.5rem] md:leading-tight">{x.h1}</h1>
    <p class="mt-2 text-lg text-navy-700">{x.intro}</p>
    <p class="mt-2 text-sm text-navy-700">
      <a class="underline" href={route('method', lang)}>{label('method', lang)}</a> · <a class="underline" href={route('about', lang)}>{label('about', lang)}</a>{r('gdb-tabelle') && <> · <a class="underline" href={r('gdb-tabelle')}>GdB-Tabelle</a></>}
    </p>
  </header>
  <section id="rechner" data-outil aria-label="Gesamt-GdB-Rechner">
    <GesamtRechner client:load methodHref={route('method', lang)} />
  </section>
  <section class="mt-8" aria-labelledby="kurz">
    <h2 id="kurz" class="sr-only">Kurz gesagt</h2>
    <Clamp text={x.resume(h)} lang={lang} id="clamp-home" sentences={2} />
    <p class="mt-4 border-l-4 border-accent-600 pl-4 text-navy-800">Was diese Seite anders macht: Sie übersetzt die neue Fassung von Teil A Nummer 3 Wort für Wort in einen Rechenweg, zeigt statt einer erfundenen Formel die Spanne, die der Wortlaut erlaubt, und nennt die Annahme dafür offen. Zu jedem Ergebnis stehen die Rechte mit den Beträgen von 2026 und ihren Paragraphen, ohne Anmeldung und ohne Formular.</p>
  </section>
  <section class="mt-10 border-t border-navy-200 pt-6" aria-labelledby="raster" data-chrome>
    <h2 id="raster" class="text-2xl font-bold text-navy-900">Erstes Leiden GdB 40: was ein zweites daraus macht</h2>
    <p class="mt-2 text-navy-700">Spanne des Gesamt-GdB je nach Einzelwert des zweiten Leidens und Zusammenhang. Ab 50 ist man schwerbehindert.</p>
    <div class="mt-4 overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr><th scope="col" class="border-b border-navy-300 bg-navy-50 px-2 py-2 text-left">Zweites Leiden</th>{arten.map((a) => <th scope="col" class="border-b border-navy-300 bg-navy-50 px-2 py-2 text-right">{a.name}</th>)}</tr></thead>
        <tbody>{raster.map((z) => <tr class="border-b border-navy-100"><th scope="row" class="px-2 py-1.5 text-left font-normal text-navy-900">GdB {z.g}</th>{z.w.map((w) => <td class={`tabular-nums px-2 py-1.5 text-right ${w.max >= 50 ? 'font-semibold text-navy-900' : 'text-navy-700'}`}>{sp(w)}</td>)}</tr>)}</tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-navy-600">Fett: Die Spanne erreicht GdB 50. Die Spannen folgen dem Wortlaut von Teil A Nr. 3.3 und 3.5 und der auf der Methodikseite genannten Schrittgröße.</p>
  </section>
  <aside class="mt-10 rounded-lg border border-navy-200 bg-navy-50 p-4" aria-labelledby="irrtum" data-chrome>
    <h2 id="irrtum" class="text-lg font-bold text-navy-900">Verbreitete Irrtümer, am Wortlaut geprüft</h2>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-navy-800">
      <li>„GdB 30 und GdB 30 ergeben 60“: Addition ist ausdrücklich unzulässig (Teil A Nr. 3.2).</li>
      <li>„Jedes weitere Leiden bringt 10 Punkte“: Ein GdB von 10 erhöht in der Regel nicht, einer von 20 vielfach nicht (Nr. 3.5).</li>
      <li>„Zum ersten Wert kommen 10 oder 20 Punkte hinzu“: Diese Beispiele standen bis zum {dt('2025-10-02')} in Teil A und sind gestrichen.</li>
      <li>„Der Pauschbetrag bei GdB 60 beträgt 1.420 €“: Seit 2021 sind es {formatMoney(P.pauschbetrag.stufen[4][1], 0, lang)} (§ 33b Abs. 3 EStG).</li>
    </ul>
  </aside>
  <div class="prose prose-slate mt-10 max-w-none border-t border-navy-200 pt-4">
    {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <MiniSim client:load kind={p} lang={lang} href={`${route('home', lang)}#rechner`} />)}
  </div>
</PageLayout>
